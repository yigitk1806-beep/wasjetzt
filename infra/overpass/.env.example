# Beispielwerte für die eigene Overpass-Instanz.
# Kopieren nach infra/overpass/.env und anpassen. Keine Geheimnisse nötig –
# Overpass kennt keine Zugangsdaten; die Absicherung passiert im Reverse Proxy.

# Port auf dem Host. Bindet nur an 127.0.0.1.
OVERPASS_PORT=12345

# Welche Region importiert wird. Standard: Berlin.
# Weitere Auszüge: https://download.geofabrik.de/
OVERPASS_PLANET_URL=https://download.geofabrik.de/europe/germany/berlin-latest.osm.bz2

# Aktualisierung. Leer = kein Update, der Datenstand bleibt beim Import.
# Für Berlin: https://download.geofabrik.de/europe/germany/berlin-updates/
OVERPASS_DIFF_URL=
OVERPASS_UPDATE_SLEEP=3600

# Grenzen je Abfrage.
OVERPASS_MAX_TIMEOUT=60
OVERPASS_SPACE=2147483648
OVERPASS_META=no

# Speichergrenze des Containers.
OVERPASS_MEMORY_LIMIT=4g
