# Beispielwerte. Kopieren nach .env und ausfüllen.
# Niemals echte Zugangsdaten in diese Datei – sie liegt im Git.

# ---------------------------------------------------------------- Datenbank
# Neon-Postgres, gepoolte Verbindung ("-pooler" im Host).
DATABASE_URL=postgresql://benutzer:passwort@host-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ----------------------------------------------------------------- Overpass
# Eigene Instanz. Bleibt die Variable leer, fragt WasJetzt wie bisher die
# öffentlichen Instanzen – die App funktioniert also auch ohne.
# Lokal mit Docker: http://localhost:12345/api/interpreter
OVERPASS_PRIMARY_URL=
# Wie lange auf die eigene Instanz gewartet wird, bevor ausgewichen wird.
OVERPASS_PRIMARY_TIMEOUT_MS=6000
# Ein einzelnes Ausweichziel. Leer = die eingebaute Liste öffentlicher
# Instanzen (overpass-api.de, kumi.systems, private.coffee).
OVERPASS_FALLBACK_URL=

# -------------------------------------------------------------------- Karte
# Eigene Kartenkacheln für echten Traffic; leer = OpenStreetMap-Standard.
NEXT_PUBLIC_TILE_URL=
NEXT_PUBLIC_TILE_ATTRIBUTION=
